= form_with model: [:admin, @contact_group], class: "space-y-6" do |f|
  - if @contact_group.errors.any?
    .alert.alert-error.mb-4
      %ul
        - @contact_group.errors.full_messages.each do |msg|
          %li= msg

  .form-control
    %label.label
      %span.label-text Name
    = f.text_field :name, class: "input input-bordered w-full", required: true, placeholder: "e.g. Youth Group, Choir, Elders"

  .form-control
    %label.label
      %span.label-text Members
    .bg-base-200.rounded-lg.p-4.max-h-96.overflow-y-auto
      - @members.each do |household, members|
        .mb-3{ data: { controller: "select-all-household" } }
          .flex.items-center.gap-2.mb-1
            %h4.font-semibold.text-sm.opacity-70= household.name
            %button.btn.btn-ghost.btn-xs.opacity-50{ type: "button", data: { action: "click->select-all-household#toggleAll" } } select all
          .ml-4.space-y-1{ data: { "select-all-household-target" => "checkboxes" } }
            - members.each do |member|
              %label.flex.items-start.gap-2.cursor-pointer
                = check_box_tag "contact_group[member_ids][]", member.id, @contact_group.member_ids.include?(member.id), class: "checkbox checkbox-sm checkbox-primary shrink-0 mt-1"
                .min-w-0
                  %span.block= member.full_name
                  .flex.flex-wrap.items-center.gap-x-3.gap-y-1.text-xs
                    - if member.phone.present?
                      %span.opacity-50= member.phone
                    - else
                      %span.badge.badge-warning.badge-xs No phone
                    - if member.email.present?
                      %span.opacity-50.break-all= member.email

  = hidden_field_tag "contact_group[member_ids][]", ""

  .flex.gap-3
    = f.submit class: "btn btn-primary"
    = link_to "Cancel", admin_contact_groups_path, class: "btn btn-ghost"
