%turbo-frame#view_contact_group_content
  .space-y-6
    %div
      %h3.text-xl.font-semibold= @contact_group.name
      %p.text-sm.opacity-60.mt-1= pluralize(@group_members.size, "member")

    %section
      %h4.font-medium.mb-3 Members
      - if @group_members.any?
        .divide-y.divide-base-300
          - @group_members.each do |member|
            .py-3.first:pt-0
              %p.font-semibold= member.full_name
              %p.text-sm.opacity-60= member.household.name
              - if member.email.present?
                %p.text-sm.break-all= mail_to member.email, member.email, class: "link link-hover"
              - if member.phone.present?
                %p.text-sm= member.phone
      - else
        %p.opacity-60 No members in this group yet.

    .border-t.border-base-300.pt-4
      = link_to "Edit group", edit_admin_contact_group_path(@contact_group), class: "btn btn-outline min-h-11", data: { turbo_frame: "_top" }
