%turbo-frame#view_registration_content
  .space-y-6
    %div
      .flex.items-center.gap-2
        %h3.text-xl.font-semibold= @registration.full_name
        %span.badge{ class: @registration.cancelled? ? "badge-warning" : "badge-success" }
          = @registration.cancelled? ? "Cancelled" : "Active"
      %p.text-sm.opacity-60= "Submitted #{@registration.created_at.to_fs(:long)}"
      - if @registration.cancelled?
        %p.text-sm.text-warning= "Cancelled #{@registration.cancelled_at.to_fs(:long)}"

    %div
      %h4.font-medium.mb-3 Contact Information
      .space-y-3
        %div
          %p.text-sm.opacity-60 Email
          %p= mail_to @registration.email, @registration.email, class: "link link-hover"
        %div
          %p.text-sm.opacity-60 Phone
          %p= @registration.phone

    %div
      %h4.font-medium.mb-3 Registration Answers
      - if @conference.questions.any?
        %dl.space-y-4
          - @conference.questions.each do |question|
            - answer = @registration.answer_for(question)
            %div
              %dt.text-sm.opacity-60= question.label
              %dd.whitespace-pre-wrap= answer&.display_value.presence || "—"
      - else
        %p.opacity-60 No custom questions were configured.

    .flex.flex-wrap.items-center.gap-3.border-t.border-base-300.pt-4
      %button.btn.btn-primary{ type: "button", data: { controller: "modal", action: "click->modal#open", modal_target_param: "edit_registration_slideout", base_url: edit_admin_conference_registration_path(@conference, @registration, slideout: true) }, onclick: "this.closest('dialog').close()" } Edit
      - if @registration.cancelled?
        = button_to "Reactivate", reactivate_admin_conference_registration_path(@conference, @registration), method: :patch, class: "btn btn-outline"
      - else
        = button_to "Cancel registration", cancel_admin_conference_registration_path(@conference, @registration), method: :patch, class: "btn btn-error", data: { turbo_confirm: "Cancel this registration? Its information and answers will be retained." }
