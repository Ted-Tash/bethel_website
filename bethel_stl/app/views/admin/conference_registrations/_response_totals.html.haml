- if questions.any?
  %details.collapse.collapse-arrow.bg-base-100.shadow-sm.mb-6
    %summary.collapse-title.font-semibold
      Response totals
      %span.block.text-xs.font-normal.opacity-60.mt-1 Counts for the current status and search. Expand to view.
    .collapse-content
      %div{ class: "grid grid-cols-1 gap-5 pt-2 md:grid-cols-2 lg:grid-cols-3" }
        - questions.each do |question|
          - counts = response_counts.fetch(question.id)
          %section.min-w-0
            %h3.text-sm.font-semibold.mb-2= question.label
            %dl.text-sm
              - counts[:options].each do |option, count|
                %div{ class: "flex items-baseline justify-between gap-4 border-b border-base-200 py-1.5" }
                  %dt.break-words.min-w-0= option
                  %dd.font-semibold.tabular-nums= count
              - if counts[:unanswered].positive?
                %div{ class: "flex items-baseline justify-between gap-4 py-1.5 opacity-60" }
                  %dt Unanswered
                  %dd.tabular-nums= counts[:unanswered]
