%h1.text-2xl.font-bold.mb-6.sm:text-3xl Events

-# ==================== CALENDAR SOURCES ====================
.card.bg-base-100.shadow-md.mb-8
  .card-body.min-w-0.p-4.sm:p-6
    %h2.card-title.mb-4 Calendar Sources
    %p.opacity-60.mb-4
      Add a Google Calendar ID to import events from. You can find it in Google Calendar under
      %strong Settings → [Your Calendar] → Integrate calendar.

    - if @calendar_sources.any?
      .mb-6
        = render layout: 'admin/shared/responsive_table', locals: { label: 'Calendar sources' } do
          %thead
            %tr
              %th{ scope: 'col' } Name
              %th{ scope: 'col' } Calendar ID
              %th{ scope: 'col' } Events
              %th{ scope: 'col' } Actions
          %tbody
            - @calendar_sources.each do |source|
              %tr
                %td{ data: { label: 'Name' } }= source.name
                %td.break-all{ data: { label: 'Calendar ID' } }
                  %code.text-sm= source.google_calendar_id
                %td{ data: { label: 'Events' } }
                  .badge.badge-neutral= source.events.count
                %td
                  .flex.flex-wrap.gap-2
                    = button_to "Sync Now", admin_events_sync_path(calendar_source_id: source.id), method: :post, class: "btn btn-primary btn-sm min-h-11"
                    = button_to "Remove", admin_events_destroy_source_path(id: source.id), method: :delete, class: "btn btn-error btn-outline btn-sm min-h-11", data: { turbo_confirm: "Remove '#{source.name}' and all its imported events?" }

    .divider

    = form_with model: CalendarSource.new, url: add_source_admin_events_path, class: "grid grid-cols-1 gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)_auto] lg:items-end" do |f|
      .form-control.min-w-0
        %label.label
          %span.label-text Name (e.g. "Bethel Church")
        = f.text_field :name, class: "input input-bordered w-full min-w-0 text-base", placeholder: "My Calendar", required: true
      .form-control.min-w-0
        %label.label
          %span.label-text Google Calendar ID
        = f.text_field :google_calendar_id, class: "input input-bordered w-full min-w-0 text-base", placeholder: "abc123@group.calendar.google.com", required: true
      = f.submit "Add Calendar", class: "btn btn-primary"

-# ==================== EVENTS LIST ====================
.card.bg-base-100.shadow-md
  .card-body.min-w-0.p-4.sm:p-6
    %h2.card-title.mb-4 Upcoming Events
    %p.opacity-60.mb-4
      Events imported from your calendars. Toggle
      %strong "Make Public"
      to show an event on the website.

    - if @events.any?
      = render layout: 'admin/shared/responsive_table', locals: { label: 'Upcoming events' } do
        %thead
          %tr
            %th{ scope: 'col' } Public
            %th{ scope: 'col' } Event
            %th{ scope: 'col' } Date & Time
            %th{ scope: 'col' } Location
            %th{ scope: 'col' } Source
            %th{ scope: 'col' } Action
        %tbody
          - @events.each do |event|
            %tr{ class: event.public? ? "" : "opacity-50" }
              %td{ data: { label: 'Visibility' } }
                - if event.public?
                  .badge.badge-success.badge-sm ✓ Public
                - else
                  .badge.badge-ghost.badge-sm Hidden
              %td{ class: '@max-3xl:col-span-full', data: { label: 'Event' } }
                .font-semibold= event.title
                - if event.description.present?
                  %p.text-sm.opacity-60{ class: 'line-clamp-3 @3xl:max-w-xs' }= event.description
              %td.whitespace-nowrap{ data: { label: 'Date & time' } }
                - if event.all_day?
                  = event.starts_at.strftime("%b %-d, %Y")
                  %span.badge.badge-outline.badge-sm.ml-1 All Day
                - else
                  = event.starts_at.strftime("%b %-d, %Y %-I:%M %p")
              %td{ data: { label: 'Location' } }= event.location.presence || "—"
              %td{ data: { label: 'Source' } }= event.calendar_source.name
              %td
                = button_to toggle_public_admin_event_path(event), method: :patch, class: "btn btn-sm min-h-11 #{event.public? ? 'btn-warning' : 'btn-success'}" do
                  = event.public? ? "Hide" : "Make Public"
    - else
      .text-center.py-8
        %p.text-lg.opacity-60 No upcoming events yet.
        %p.opacity-40.mt-1 Add a calendar source above and hit "Sync Now" to import events.
