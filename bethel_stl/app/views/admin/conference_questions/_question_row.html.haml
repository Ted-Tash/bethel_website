%tr.hover:bg-base-200{ data: { question_id: question.id } }
  %td
    %button.btn.btn-ghost.btn-sm.btn-square.cursor-grab.active:cursor-grabbing{ type: "button", title: "Drag to reorder", aria: { label: "Drag #{question.label} to reorder" }, data: { sortable_handle: true } }
      %svg.w-5.h-5{ xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "currentColor", aria: { hidden: "true" } }
        %circle{ cx: "9", cy: "6", r: "1.5" }
        %circle{ cx: "15", cy: "6", r: "1.5" }
        %circle{ cx: "9", cy: "12", r: "1.5" }
        %circle{ cx: "15", cy: "12", r: "1.5" }
        %circle{ cx: "9", cy: "18", r: "1.5" }
        %circle{ cx: "15", cy: "18", r: "1.5" }
  %td
    .font-semibold= question.label
    - if question.choice_type?
      .text-sm.opacity-50= question.choice_options.join(", ")
  %td= ConferenceQuestion::TYPES.fetch(question.question_type)
  %td
    - if question.required?
      %span.badge.badge-neutral Required
    - else
      %span.opacity-40 Optional
  %td.text-right
    %button.btn.btn-ghost.btn-sm{ type: "button", data: { controller: "modal", action: "click->modal#open", modal_target_param: "edit_question_slideout", base_url: edit_admin_conference_question_path(conference, question, slideout: true) } } Edit
