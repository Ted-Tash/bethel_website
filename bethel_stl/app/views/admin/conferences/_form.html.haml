- slideout = local_assigns[:slideout]
- form_url = conference.persisted? ? admin_conference_path(conference, slideout: slideout || nil, context: params[:context]) : admin_conferences_path(slideout: slideout || nil)
- form_method = conference.persisted? ? :patch : :post

= form_with model: [:admin, conference], url: form_url, method: form_method, class: "space-y-6" do |f|
  - if conference.errors.any?
    .alert.alert-error
      %div
        %p.font-semibold Please fix the following:
        %ul.list-disc.list-inside.mt-1
          - conference.errors.full_messages.each do |message|
            %li= message

  .form-control
    %label.label{ for: "conference_name" }
      %span.label-text Name
    = f.text_field :name, class: "input input-bordered w-full", required: true, autofocus: true, placeholder: "Spring Conference 2027"

  .form-control
    %label.label{ for: "conference_slug" }
      %span.label-text Public URL slug
    = f.text_field :slug, class: "input input-bordered w-full", required: true, placeholder: "spring-conference-2027"
    .label
      %span.label-text-alt.opacity-60 Lowercase letters, numbers, and hyphens.

  .form-control
    %label.label{ for: "conference_description" }
      %span.label-text Description
    = f.text_area :description, class: "textarea textarea-bordered w-full min-h-28", placeholder: "Tell attendees what the conference is about."

  .form-control
    %label.label{ for: "conference_location" }
      %span.label-text Location
    = f.text_field :location, class: "input input-bordered w-full", placeholder: "Venue name or address"

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    .form-control
      %label.label{ for: "conference_starts_at" }
        %span.label-text Starts
      = f.datetime_local_field :starts_at, class: "input input-bordered w-full"
    .form-control
      %label.label{ for: "conference_ends_at" }
        %span.label-text Ends
      = f.datetime_local_field :ends_at, class: "input input-bordered w-full"

  %label.flex.items-start.gap-3.cursor-pointer.rounded-lg.bg-base-200.p-4
    = f.check_box :registration_open, class: "toggle toggle-primary mt-0.5 shrink-0"
    %span
      %span.block.font-semibold Public registration is open
      %span.block.text-sm.opacity-60 Anyone with the public link can submit a registration.

  .flex.items-center.gap-3
    .flex-1
    - if slideout
      %button.btn.btn-ghost{ type: "button", onclick: "this.closest('dialog').close()" } Cancel
    - else
      = link_to "Cancel", admin_conferences_path, class: "btn btn-ghost"
    = f.submit (conference.persisted? ? "Save Changes" : "Create Conference"), class: "btn btn-primary"
