.rounded-lg.bg-base-200.p-3{ data: { nested_form_target: "fields" } }
  = f.hidden_field :_destroy if f.object.persisted?
  = f.label :email, "Admin email", class: "block text-sm font-medium mb-2"
  .flex.items-center.gap-2
    - options = (admin_emails + [f.object.email]).compact_blank.uniq.sort
    = f.select :email, options, { include_blank: "Select an admin" }, class: "select select-bordered w-full min-w-0"
    %button.btn.btn-ghost.btn-sm{ type: "button", data: { action: "nested-form#remove" } } Remove
