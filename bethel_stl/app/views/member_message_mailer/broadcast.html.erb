<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#f3f5f7" style="width: 100%; background-color: #f3f5f7;">
  <tr>
    <td align="center" style="padding: 32px 12px;">
      <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" bgcolor="#ffffff" style="width: 100%; max-width: 600px; background-color: #ffffff; border: 1px solid #e2e7ec; border-radius: 8px;">
        <tr>
          <td style="padding: 28px 28px 0; border-top: 4px solid #375b75; border-radius: 8px 8px 0 0;">
            <p style="margin: 0 0 20px; color: #375b75; font-size: 12px; font-weight: bold; letter-spacing: 1.2px; line-height: 1.5; text-transform: uppercase;">Bethel Community Church</p>
            <h1 style="margin: 0 0 24px; color: #1f3040; font-size: 26px; font-weight: bold; line-height: 1.3; overflow-wrap: anywhere;"><%= @message.subject %></h1>
          </td>
        </tr>
        <tr>
          <td style="padding: 0 28px 20px; color: #354454; font-size: 16px; line-height: 1.7; overflow-wrap: anywhere;">
            <%= simple_format(h(@message.body), style: "margin: 0 0 18px;") %>
          </td>
        </tr>
        <tr>
          <td class="email-footer" bgcolor="#f8f9fb" style="padding: 24px 28px; background-color: #f8f9fb; border-top: 1px solid #e2e7ec; border-radius: 0 0 8px 8px; color: #526579; font-size: 13px; line-height: 1.7;">
            <p style="margin: 0 0 4px; color: #354454; font-size: 14px; font-weight: bold;">Bethel Community Church</p>
            <p style="margin: 0 0 16px;"><%= @postal_address %></p>
            <p style="margin: 0 0 4px;">You can unsubscribe from congregation emails at any time.</p>
            <a href="<%= @unsubscribe_url %>" style="color: #526579; text-decoration: underline;">Unsubscribe from congregation email</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
