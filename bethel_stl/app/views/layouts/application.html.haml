!!!
%html{ data: { theme: "winter" } }
  %head
    %title= content_for(:title) || "Bethel Community Church"
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }
    %meta{ name: "description", content: content_for(:description) || "Welcome to Bethel Community Church — a Bible-believing church in St. Louis, MO. Join us for worship, community, and Christ-centered fellowship." }
    %meta{ name: "apple-mobile-web-app-capable", content: "yes" }
    %meta{ name: "application-name", content: "Bethel Community Church" }
    %meta{ name: "mobile-web-app-capable", content: "yes" }
    %meta{ name: "theme-color", content: "#293648" }

    -# Open Graph (Facebook, iMessage, Slack, etc.)
    %meta{ property: "og:type", content: "website" }
    %meta{ property: "og:title", content: content_for(:title) || "Welcome to Bethel Community Church" }
    %meta{ property: "og:description", content: content_for(:description) || "A Bible-believing church in St. Louis, MO. Join us for worship, community, and Christ-centered fellowship." }
    %meta{ property: "og:image", content: "#{request.base_url}#{content_for(:og_image).presence || '/og-image-v2.png'}" }
    %meta{ property: "og:image:secure_url", content: "#{request.base_url}#{content_for(:og_image).presence || '/og-image-v2.png'}" }
    %meta{ property: "og:image:type", content: "image/png" }
    %meta{ property: "og:image:width", content: "1200" }
    %meta{ property: "og:image:height", content: "630" }
    %meta{ property: "og:url", content: request.original_url }
    %meta{ property: "og:site_name", content: "Bethel Community Church" }
    %meta{ property: "og:locale", content: "en_US" }

    -# Twitter Card
    %meta{ name: "twitter:card", content: "summary_large_image" }
    %meta{ name: "twitter:title", content: content_for(:title) || "Welcome to Bethel Community Church" }
    %meta{ name: "twitter:description", content: content_for(:description) || "A Bible-believing church in St. Louis, MO. Join us for worship, community, and Christ-centered fellowship." }
    %meta{ name: "twitter:image", content: "#{request.base_url}#{content_for(:og_image).presence || '/og-image-v2.png'}" }

    = csrf_meta_tags
    = csp_meta_tag
    = action_cable_meta_tag

    = yield :head

    %link{ rel: "icon", href: "/favicon-32x32.png", sizes: "32x32", type: "image/png" }
    %link{ rel: "icon", href: "/favicon-16x16.png", sizes: "16x16", type: "image/png" }
    %link{ rel: "icon", href: "/icon.svg", type: "image/svg+xml" }
    %link{ rel: "apple-touch-icon", href: "/apple-touch-icon.png", sizes: "180x180" }
    %link{ rel: "manifest", href: "/site.webmanifest" }

    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body.min-h-screen.flex.flex-col.bg-base-100
    = render 'shared/navbar'
    - if (msg = banner_message)
      .alert.alert-warning.rounded-none.justify-between.gap-4{ data: { controller: "dismissible" } }
        .flex.items-center.gap-2
          %svg.h-6.w-6.shrink-0{ xmlns: "http://www.w3.org/2000/svg", fill: "none", viewBox: "0 0 24 24", stroke: "currentColor", "stroke-width" => "2" }
            %path{ "stroke-linecap" => "round", "stroke-linejoin" => "round", d: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" }
          %span= msg
        %button.btn.btn-sm.btn-ghost{ data: { action: "dismissible#dismiss" } } ✕
    - if content_for?(:hero)
      = render 'shared/slideshow_hero'
    %main.flex-grow
      = yield
    = render 'shared/footer'
