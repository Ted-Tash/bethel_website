<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f3f5f7; padding: 24px 12px;">
  <tr>
    <td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 640px; background-color: #ffffff; border: 1px solid #e2e8ef; border-radius: 12px;">
        <tr>
          <td style="padding: 28px 24px 20px;">
            <p style="margin: 0 0 8px; color: #526579; font-size: 13px;">Bethel Community Church</p>
            <h1 style="margin: 0 0 8px; font-size: 24px; line-height: 1.3; color: #273444;">New registration</h1>
            <p style="margin: 0; font-size: 16px; line-height: 1.5;"><%= @conference.name %></p>
          </td>
        </tr>
        <tr>
          <td style="padding: 0 24px 24px;">
            <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; font-size: 14px; line-height: 1.5; table-layout: fixed;">
              <caption style="text-align: left; font-weight: bold; padding: 0 0 12px;">Registration details</caption>
              <tbody>
                <% @details.each_with_index do |(label, value), index| %>
                  <tr style="background-color: <%= index.even? ? '#f7f9fc' : '#ffffff' %>;">
                    <th scope="row" width="38%" style="padding: 12px; border-bottom: 1px solid #e2e8ef; text-align: left; vertical-align: top; color: #526579; font-weight: 600; overflow-wrap: anywhere;"><%= label %></th>
                    <td style="padding: 12px; border-bottom: 1px solid #e2e8ef; vertical-align: top; white-space: pre-wrap; overflow-wrap: anywhere;"><%= value %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            <p style="margin: 24px 0 0; font-size: 14px;">
              <%= link_to "Manage registrations →", admin_conference_registrations_url(@conference), style: "color: #005fcc; font-weight: bold;" %>
            </p>
            <p style="margin: 16px 0 0; color: #526579; font-size: 12px; line-height: 1.5;">You received this notification because you are listed as an admin for this conference. Reply to this email to contact the registrant.</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
