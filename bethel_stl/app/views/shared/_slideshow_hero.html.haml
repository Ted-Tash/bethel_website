#site_hero.relative.overflow-hidden{ class: content_for?(:hero_tall) ? "min-h-[70vh]" : "py-20" }
  - if content_for?(:hero_image)
    = image_tag content_for(:hero_image), class: "absolute inset-0 w-full h-full object-cover", alt: ""
    .absolute.inset-0{ style: "background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.3) 100%)" }
  - else
    .absolute.inset-0.bg-base-200
  - text_classes = content_for?(:hero_image) ? "text-white" : "text-base-content"
  .relative.z-10.flex.items-center.justify-center.text-center{ class: "#{text_classes} #{content_for?(:hero_tall) ? 'min-h-[70vh]' : 'py-20'}", style: content_for?(:hero_image) ? "text-shadow: 0 2px 12px rgba(0,0,0,0.8), 0 0 40px rgba(0,0,0,0.4)" : "" }
    - if content_for?(:hero)
      = yield :hero
