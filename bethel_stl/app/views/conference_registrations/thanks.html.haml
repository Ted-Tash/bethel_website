- content_for :title, "Registration received — #{@conference.name}"

.section.py-20.px-4
  .max-w-2xl.mx-auto.text-center
    .card.bg-base-100.shadow-xl.border.border-base-200
      .card-body.py-12
        .text-success.text-5xl.mb-4 ✓
        %h1.text-3xl.font-bold Registration received
        %p.text-lg.mt-3
          Thank you for registering for
          %strong= @conference.name
          = "."
        %p.opacity-70.mt-2 Your information has been saved.
        = link_to "Return to Bethel Community Church", root_path, class: "btn btn-primary mt-6"
